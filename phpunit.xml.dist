<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
	bootstrap="tests/php/bootstrap.php"
	cacheDirectory=".phpunit.cache"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="autoloader"><file>tests/php/AutoloaderTest.php</file></testsuite>
		<testsuite name="core"><directory>tests/php/core</directory></testsuite>
		<testsuite name="admin"><directory>tests/php/admin</directory></testsuite>
		<testsuite name="support"><directory>tests/php/support</directory></testsuite>
		<testsuite name="ui"><directory>tests/php/ui</directory></testsuite>
		<testsuite name="http"><directory>tests/php/http</directory></testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">includes</directory>
		</include>
	</source>
</phpunit>
